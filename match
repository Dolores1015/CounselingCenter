    <script>
        // --- 手機選單與下拉邏輯 (與首頁相同) ---
        const menuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        menuButton.addEventListener('click', () => {
            const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
            menuButton.setAttribute('aria-expanded', String(!isOpen));
            mobileMenu.classList.toggle('hidden');
        });

        const dropdownButtons = document.querySelectorAll('.dropdown > button');
        dropdownButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                const menu = button.nextElementSibling;
                const isExpanded = button.getAttribute('aria-expanded') === 'true';
                document.querySelectorAll('.dropdown-menu.show').forEach(m => {
                    if (m !== menu) {
                        m.classList.remove('show');
                        m.previousElementSibling.setAttribute('aria-expanded', 'false');
                    }
                });
                menu.classList.toggle('show');
                button.setAttribute('aria-expanded', String(!isExpanded));
            });
        });
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.dropdown')) {
                document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                    menu.classList.remove('show');
                    menu.previousElementSibling.setAttribute('aria-expanded', 'false');
                });
            }
        });

        // --- 媒合邏輯區塊 ---

        // 1. 定義議題
        const issues = [
            { id: 'anxiety', label: '焦慮' },
            { id: 'depression', label: '憂鬱' },
            { id: 'trauma', label: '創傷' },
            { id: 'interpersonal', label: '人際' },
            { id: 'intimacy', label: '親密關係' }
        ];

        // 2. 模擬心理師資料庫 (包含專長標籤)
        const therapists = [
            {
                id: 1,
                name: '林語心',
                title: '諮商心理師',
                image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=200&h=200',
                specialties: ['anxiety', 'depression', 'trauma'],
                description: '擅長以溫暖包容的態度，陪伴個案走過情緒低谷與創傷復原。'
            },
            {
                id: 2,
                name: '陳柏宇',
                title: '諮商心理師',
                image: 'https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&q=80&w=200&h=200',
                specialties: ['interpersonal', 'intimacy'],
                description: '專精於伴侶諮商與人際界線探索，協助釐清關係中的互動盲點。'
            },
            {
                id: 3,
                name: '黃雅婷',
                title: '臨床心理師',
                image: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=200&h=200',
                specialties: ['anxiety', 'interpersonal'],
                description: '結合認知行為療法，協助個案具體處理生活中的焦慮與社交壓力。'
            },
            {
                id: 4,
                name: '張家瑋',
                title: '諮商心理師',
                image: 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&q=80&w=200&h=200',
                specialties: ['depression', 'intimacy', 'trauma'],
                description: '運用深度心理學取向，陪伴探索原生家庭影響與深層的情緒議題。'
            }
        ];

        // 3. 初始化畫面與綁定事件
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('issue-container');
            const startBtn = document.getElementById('start-match-btn');
            const reselectBtn = document.getElementById('reselect-btn');
            const selectionSection = document.getElementById('selection-section');
            const resultsSection = document.getElementById('results-section');
            const errorMsg = document.getElementById('error-message');

            // 渲染議題選項
            issues.forEach(issue => {
                const wrapper = document.createElement('div');
                wrapper.innerHTML = `
                    <input type="checkbox" id="issue-${issue.id}" value="${issue.id}" class="issue-checkbox hidden">
                    <label for="issue-${issue.id}" class="cursor-pointer px-6 py-3 rounded-full border-2 border-gray-200 text-gray-600 hover:border-morandi-green transition-all duration-200 block text-center select-none font-medium">
                        ${issue.label}
                    </label>
                `;
                container.appendChild(wrapper);
            });

            // 點擊開始媒合
            startBtn.addEventListener('click', () => {
                // 取得選中的項目
                const selectedCheckboxes = document.querySelectorAll('.issue-checkbox:checked');
                if (selectedCheckboxes.length === 0) {
                    errorMsg.classList.remove('hidden');
                    return;
                }
                
                errorMsg.classList.add('hidden');
                const selectedIssues = Array.from(selectedCheckboxes).map(cb => cb.value);

                // 執行媒合邏輯並顯示
                displayResults(selectedIssues);

                // 動畫切換區塊
                selectionSection.classList.remove('visible-state');
                selectionSection.classList.add('hidden-state');
                
                setTimeout(() => {
                    resultsSection.classList.remove('hidden-state');
                    resultsSection.classList.add('visible-state');
                }, 400); // 等待淡出完成
            });

            // 點擊重新選擇
            reselectBtn.addEventListener('click', () => {
                resultsSection.classList.remove('visible-state');
                resultsSection.classList.add('hidden-state');
                
                setTimeout(() => {
                    selectionSection.classList.remove('hidden-state');
                    selectionSection.classList.add('visible-state');
                }, 400);
            });
        });

        // 4. 媒合計算與渲染邏輯
        function displayResults(selectedIssues) {
            const listContainer = document.getElementById('therapist-list');
            listContainer.innerHTML = ''; // 清空先前結果

            // 計算每位心理師的分數 (中幾個標籤就得幾分)
            const scoredTherapists = therapists.map(therapist => {
                const score = therapist.specialties.reduce((acc, specialty) => {
                    return acc + (selectedIssues.includes(specialty) ? 1 : 0);
                }, 0);
                return { ...therapist, matchScore: score };
            });

            // 排序：分數高的在前，若分數相同則保持原本順序或隨機（這裡維持原序）
            scoredTherapists.sort((a, b) => b.matchScore - a.matchScore);

            // 過濾掉0分的(可選，這裡選擇保留但排在後面，或者只顯示大於0的)
            const matchedTherapists = scoredTherapists.filter(t => t.matchScore > 0);

            if(matchedTherapists.length === 0){
                 listContainer.innerHTML = `<div class="p-8 text-center bg-gray-50 rounded-2xl text-gray-500">目前沒有完全吻合的心理師，建議您可以直接預約，由行政人員為您安排。</div>`;
                 return;
            }

            // 渲染卡片
            matchedTherapists.forEach((therapist, index) => {
                // 找出配對成功的標籤中文
                const matchedLabels = therapist.specialties
                    .filter(s => selectedIssues.includes(s))
                    .map(s => issues.find(i => i.id === s).label);

                const card = document.createElement('div');
                // 動畫延遲出現效果
                card.className = `bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-6 items-start md:items-center hover:shadow-md transition-all duration-300 transform opacity-0 translate-y-4`;
                
                // 設定一點動畫延遲
                setTimeout(() => {
                    card.classList.remove('opacity-0', 'translate-y-4');
                }, 100 * (index + 1));

                card.innerHTML = `
                    <div class="flex-shrink-0">
                        <img src="${therapist.image}" alt="${therapist.name} 心理師" class="w-24 h-24 rounded-full object-cover border-4 border-morandi-mist">
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-center gap-3 mb-2">
                            <h3 class="text-xl font-medium text-morandi-brandBrown">${therapist.name}</h3>
                            <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">${therapist.title}</span>
                        </div>
                        <div class="flex flex-wrap gap-2 mb-3">
                            ${matchedLabels.map(label => `<span class="text-xs bg-morandi-mist text-morandi-darkGreen px-2 py-1 rounded font-medium">✓ 匹配: ${label}</span>`).join('')}
                        </div>
                        <p class="text-sm text-gray-600 leading-relaxed">${therapist.description}</p>
                    </div>
                    <div class="flex-shrink-0 w-full md:w-auto mt-4 md:mt-0">
                        <a href="booking.html?therapist=${therapist.id}" class="block w-full text-center bg-white border border-morandi-green text-morandi-green hover:bg-morandi-green hover:text-white px-6 py-2.5 rounded-lg transition-all duration-300 font-medium">
                            預約此心理師
                        </a>
                    </div>
                `;
                listContainer.appendChild(card);
            });
        }
    </script>
</body>
